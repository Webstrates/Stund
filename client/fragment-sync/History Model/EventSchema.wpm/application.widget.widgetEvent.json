{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Schema for widget-defined instant events emitted by widgets.",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "description": "Widget-defined event type identifier."
        },
        "data": {
            "description": "Widget-defined payload. Can be any JSON-serializable value."
        }
    },
    "required": [
        "type",
        "data"
    ],
    "additionalProperties": false
}
